msgstr "Diccionario serializado de estadísticas zonales por subcuenca para wyield."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:598
msgid "Pickled subwatershed zonal statistics dictionary for AET"
msgstr "Diccionario serializado de estadísticas zonales por subcuenca para AET."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:604
msgid "Pickled subwatershed zonal statistics dictionary for PET"
msgstr "Diccionario serializado de estadísticas zonales por subcuenca para PET."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:610
msgid "Pickled subwatershed zonal statistics dictionary for precip"
msgstr "Diccionario serializado de estadísticas zonales por subcuenca para precip."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:616
msgid "Pickled subwatershed zonal statistics dictionary for demand"
msgstr "Diccionario serializado de estadísticas zonales por subcuenca para demand."

