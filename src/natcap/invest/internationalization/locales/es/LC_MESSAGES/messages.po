#: src/natcap/invest/urban_cooling_model/reporter.py:146
msgid "Heavy Work Productivity Loss"
msgstr "Pérdida de productividad en trabajos pesados"

#: src/natcap/invest/urban_cooling_model/reporter.py:151
msgid "Avoided Energy Consumption"
msgstr "Consumo de energía evitado"

