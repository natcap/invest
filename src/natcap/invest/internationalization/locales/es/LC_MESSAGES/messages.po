#: src/natcap/invest/annual_water_yield/annual_water_yield.py:515
msgid "Aligned and clipped copy of ET0 input."
msgstr "Copia alineada y recortada de la capa ET0 de entrada."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:522
msgid "Map of KC values."
msgstr "Mapa de los valores de KC."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:529
msgid "Aligned and clipped copy of PAWC input."
msgstr "Copia alineada y recortada de la capa PAWC de entrada."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:536
