#: src/natcap/invest/annual_water_yield/annual_water_yield.py:269
msgid ""
"Table of biophysical parameters for each LULC class. All values in the LULC raster must have "
"corresponding entries in this table."
msgstr ""
"Tabla de parámetros biofísicos para cada clase LULC. Todos los valores del ráster LULC deben "
"tener los inputs correspondientes en esta tabla."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:278
msgid ""
"Code indicating whether the the LULC class is vegetated for the purpose of AET. Enter 1 for all "
"vegetated classes except wetlands, and 0 for all other classes, including wetlands, urban areas, "
"water bodies, etc."
msgstr ""
"Código que indica si la clase LULC tiene vegetación a efectos de la ETR. Introduzca 1 para todas "
"las clases con vegetación, excepto los humedales, y 0 para todas las demás clases, incluidos los "
"humedales, las zonas urbanas, las masas de agua, etc."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:289
msgid ""
"Maximum root depth for plants in this LULC class. Only used for classes with a 'lulc_veg' value "
"of 1."
msgstr ""
"Profundidad máxima de las raíces de las plantas de esta clase LULC. Solo se utiliza para las "
"clases con un valor 'lulc_veg' de 1."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:296
#: src/natcap/invest/urban_cooling_model/urban_cooling_model.py:94
msgid "Crop coefficient for this LULC class."
msgstr "Coeficiente de cultivo para esta clase de LULC."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:304
msgid "z parameter"
msgstr "parámetro z"

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:306
msgid ""
"The seasonality factor, representing hydrogeological characterisitics and the seasonal "
"distribution of precipitation. Values typically range from 1 - 30."
msgstr ""
"El factor de estacionalidad, que representa las características hidrogeológicas y la distribución"
" estacional de las precipitaciones. Los valores oscilan típicamente entre 1 y 30."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:315
msgid "water demand table"
msgstr "tabla de demanda de agua"

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:317
msgid ""
"A table of water demand for each LULC class. Each LULC code in the LULC raster must have a "
"corresponding row in this table.  Required if 'valuation_table_path' is provided."
msgstr ""
"Tabla de demanda de agua para cada clase LULC. Cada código LULC del ráster debe tener una fila "
"correspondiente en esta tabla. Es obligatoria si se proporciona 'valuation_table_path'."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:325
msgid "LULC code corresponding to the LULC raster"
msgstr "Código LULC correspondiente al ráster LULC"

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:330
msgid "Average consumptive water use in this LULC class."
msgstr "Uso consuntivo promedio del agua en esta clase de LULC."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:339
msgid "hydropower valuation table"
msgstr "tabla de valoración hidroeléctrica"

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:341
msgid "A table mapping each watershed to the associated valuation parameters for its hydropower station."
msgstr ""
"Una tabla que relaciona cada cuenca con los parámetros de valoración asociados a su central "
"hidroeléctrica."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:349
msgid ""
"Unique identifier for the hydropower station. This must match the 'ws_id' value for the "
"corresponding watershed in the Watersheds vector. Each watershed in the Watersheds vector must "
"have its 'ws_id' entered in this column."
msgstr ""
"Identificador único de la central hidroeléctrica. Debe coincidir con el valor \"ws_id\" de la "
"cuenca hidrográfica correspondiente en el vector \"Watersheds\". Cada cuenca hidrográfica del "
"vector Cuencas Hidrográficas debe tener su \"ws_id\" introducido en esta columna."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:359
msgid ""
"Turbine efficiency, the proportion of potential energy captured and converted to electricity by "
"the turbine."
msgstr ""
"Eficiencia de la turbina, la proporción de energía potencial captada y convertida en electricidad"
" por la turbina."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:367
msgid "The proportion of inflow water volume that is used to generate energy."
msgstr "La proporción del volumen de agua de entrada que se utiliza para generar energía."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:375
msgid ""
"The head, measured as the average annual effective height of water behind each dam at the turbine"
" intake."
msgstr ""
"La cabeza, medida como la altura media anual efectiva del agua detrás de cada represa en la toma "
"de la turbina."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:384
msgid ""
"The price of power produced by the station. Must be in the same currency used in the 'cost' "
"column."
msgstr ""
"El precio de la energía producida por la estación. Debe estar en la misma moneda utilizada en la "
"columna \"cost\"."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:392
msgid ""
"Annual maintenance and operations cost of running the hydropower station. Must be in the same "
"currency used in the 'kw_price' column."
msgstr ""
"Costo anual de mantenimiento y explotación de la central hidroeléctrica. Debe estar en la misma "
"moneda utilizada en la columna \"kw_price\"."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:401
msgid ""
"Number of years over which to value the hydropower station. This is either the station's expected"
" lifespan or the duration of the land use scenario of interest."
msgstr ""
"Número de años a lo largo de los cuales valorar la central hidroeléctrica. Se trata de la vida "
"útil prevista de la central o de la duración del escenario de uso del suelo de interés."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:411
msgid "The annual discount rate, applied for each year in the time span."
msgstr "La tasa de descuento anual, aplicada para cada año del período."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:425
msgid "Shapefile containing biophysical output values per watershed."
msgstr "Archivo shapefile con los valores de salida biofísicos por cuenca."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:435
msgid "Table containing biophysical output values per watershed."
msgstr "Tabla con los valores de salida biofísicos por cuenca."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:445
msgid "Shapefile containing biophysical output values per subwatershed."
msgstr "Archivo shapefile con los valores de salida biofísicos por subcuenca."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:455
msgid "Table containing biophysical output values per subwatershed."
msgstr "Tabla con los valores de salida biofísicos por subcuenca."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:465
msgid "The fraction of precipitation that actually evapotranspires at the pixel level."
msgstr "Fracción de la precipitación que realmente se evapotranspira a nivel de píxel."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:475
msgid "Estimated actual evapotranspiration per pixel."
msgstr "Evapotranspiración real estimada por píxel."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:483
msgid "Water demand per pixel."
msgstr "Demanda de agua por píxel."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:491
msgid "Estimated water yield per pixel."
msgstr "Rendimiento hídrico estimado por píxel."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:498
msgid "Aligned and clipped copy of LULC input."
msgstr "Copia alineada y recortada de la capa de uso y cobertura del suelo (LULC) de entrada."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:506
msgid "Aligned and clipped copy of root restricting layer depth input."
msgstr ""
"Copia alineada y recortada de la entrada de profundidad de la capa que limita el crecimiento de "
