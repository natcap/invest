msgstr "Copia alineada y recortada de la precipitación de entrada."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:552
msgid "Map of root depth."
msgstr "Mapa de profundidad de las raíces."

#: src/natcap/invest/annual_water_yield/annual_water_yield.py:559
